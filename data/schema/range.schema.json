{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SMuFL range definition",
  "type": "object",
  "properties": {
    "name": { "type": "string", "pattern": "^\\S+$" },
    "description": { "type": "string", "minLength": 1 },
    "implementationNotes": { "type": "string" },
    "firstPublishedIn": { "type": "string" },
    "codepointRangeStart": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" },
    "codepointRangeEnd": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" },
    "padUpToNearest": { "type": "integer", "minimum": 1 },
    "hidden": { "type": "boolean" },
    "supplementaryTo": { "type": ["string", "null"] },
    "glyphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
          "description": { "type": "string", "minLength": 1 },
          "alternateCodepoint": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" },
          "classes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "stylisticAlternates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "for": { "type": "string" },
          "name": { "type": "string" },
          "set": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "References an id in data/stylistic-sets.yaml, which resolves to the actual OpenType stylistic-set tag. Omit for a plain (salt) alternate."
          },
          "description": { "type": "string", "minLength": 1 }
        },
        "required": ["for", "name", "description"],
        "additionalProperties": false
      }
    },
    "ligatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "components": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
        },
        "required": ["name", "description", "components"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "description", "codepointRangeStart", "codepointRangeEnd", "glyphs"],
  "additionalProperties": false
}
