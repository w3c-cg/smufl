{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SMuFL range manifest",
  "type": "object",
  "properties": {
    "ranges": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": ["ranges"],
  "additionalProperties": false
}
